# Monitoring Stack Environment Configuration
# Copy this file to .env.monitoring and customize if needed:
#   cp .env.monitoring.example .env.monitoring

# Grafana Admin Credentials (for local development use only)
GF_SECURITY_ADMIN_PASSWORD=admin

# Port Bindings (Exposed on localhost)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Live Render Target (configured in monitoring/prometheus/prometheus.monitoring.yml)
RENDER_TARGET=distributed-task-engine.onrender.com
